# Copy to `web/.env.local` (git-ignored) and fill in. Restart `npm run dev` after a change.

# `drive`: browser copy + Google Drive. `devserver`: the boards/ folder (default for `npm run dev`).
VITE_KONEKTON_STORAGE=drive

# OAuth client ID (Web application) from Google Cloud; it is public, not a secret.
# Authorized JavaScript origins: http://localhost:5173 and https://huntermac.github.io
VITE_GOOGLE_CLIENT_ID=
